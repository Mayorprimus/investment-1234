{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/flutterwave/initialize.ts": { "maxDuration": 30 },
    "api/flutterwave/verify.ts": { "maxDuration": 30 },
    "api/flutterwave/webhook.ts": { "maxDuration": 30 },
    "api/crypto/create.ts": { "maxDuration": 30 },
    "api/crypto/ipn.ts": { "maxDuration": 30 },
    "api/auth/confirm.ts": { "maxDuration": 30 },
    "api/admin/reset-password.ts": { "maxDuration": 30 },
    "api/delete-user.ts": { "maxDuration": 30 },
    "api/cron/accrue.ts": { "maxDuration": 30 }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/accrue", "schedule": "0 0 * * *" }
  ]
}
