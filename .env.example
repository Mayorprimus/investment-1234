# ------------------ Supabase ------------------
# Project Settings -> API. Service role key is server-only, never ship it
# to the browser — the VITE_ values are the public ones Vite inlines.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------ Flutterwave (NGN deposits) ------------------
# Dashboard -> Settings -> API Keys. Webhook URL to set in Flutterwave:
#   https://<your-domain>/api/flutterwave/webhook
# FLUTTERWAVE_WEBHOOK_SECRET_HASH must match the "Secret hash" configured
# in the Flutterwave Settings -> Webhooks page.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
VITE_FLUTTERWAVE_PUBLIC_KEY=

# ------------------ NOWPayments ------------------
# Dashboard -> API settings. IPN URL to set in NOWPayments:
#   https://<your-domain>/api/crypto/ipn
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_PUBLIC_KEY=
NOWPAYMENTS_IPN_SECRET=